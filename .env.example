DISCORD_TOKEN=your_discord_bot_token
OWNER_ID=your_discord_user_id
# Optional: comma-separated Discord role IDs allowed to use HallKeeper commands.
MODERATOR_ROLE_IDS=
# Optional: number of minutes between official-news checks (minimum 1; default 1).
NEWS_POLL_INTERVAL_MINUTES=1

# Public AI replies: members can ask by mentioning HallKeeper in an enabled text channel.
# Leave AI_CHANNEL_IDS blank to allow all text channels, or provide comma-separated channel IDs.
AI_MODEL=gpt-5.6-luna
AI_MAX_OUTPUT_TOKENS=500
AI_RATE_LIMIT_MAX=5
AI_RATE_LIMIT_WINDOW_MINUTES=10
# Reply directly to HallKeeper to continue. Only the member who started the thread can continue it.
AI_CONVERSATION_TIMEOUT_MINUTES=3
AI_CONVERSATION_MAX_TURNS=4
AI_CHANNEL_IDS=
